{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TwinDatabase": "Server=(localdb)\\ThesisDB;Database=SmartHomeTwin;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Twin": {
    "StepMinutes": 15,
    "SecondsPerTick": 2,
    "DefaultScenarioId": "normal",
    "Devices": [
      { "Id": "fridge", "Name": "Fridge", "Type": "Fridge", "RatedPowerKw": 0.15 },
      { "Id": "oven", "Name": "Oven", "Type": "Oven", "RatedPowerKw": 2.5 },
      { "Id": "kettle", "Name": "Kettle", "Type": "Kettle", "RatedPowerKw": 2.0 },
      { "Id": "dishwasher", "Name": "Dishwasher", "Type": "Dishwasher", "RatedPowerKw": 1.8 },
      { "Id": "washing-machine", "Name": "Washing machine", "Type": "WashingMachine", "RatedPowerKw": 2.0 },
      { "Id": "solar", "Name": "Solar PV", "Type": "SolarPv", "RatedPowerKw": 5.0 }
    ],
    "Battery": {
      "Id": "battery",
      "Name": "Home battery",
      "CapacityKwh": 10,
      "MaxPowerKw": 5,
      "MinSocPercent": 10,
      "ChargeEfficiency": 1.0,
      "DischargeEfficiency": 1.0
    },
    "Alerts": {
      "GridImportLimitKw": 3.0,
      "HighLoadKw": 4.0
    }
  }
}
